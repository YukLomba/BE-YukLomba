@startuml Register Competition Sequence

actor Student
participant "Competition Controller" as CC
participant "Competition Service" as CS
participant "Competition Repository" as CR

Student -> CC: POST /competitions/{id}/register
CC -> CS: RegisterUserToCompetition(authInfo, competitionID)
CS -> CR: FindByID(competitionID)
CR --> CS: Competition object
CS -> CS: Validate deadline
CS -> CR: FindUserRegistration(competitionID, userID)
alt Not registered
  CR --> CS: Not found
  CS -> CR: CreateUserRegistration(registration)
  CR --> CS: Created registration
  CS --> CC: Success response
  CC --> Student: 201 Created
else Already registered
  CR --> CS: Registration exists
  CS --> CC: Error response
  CC --> Student: 409 Conflict
end

@enduml
