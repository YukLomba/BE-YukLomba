@startuml Get Analytics Sequence

actor Admin
participant "User Controller" as UC
participant "User Service" as US
participant "User Repository" as UR
participant "Competition Repository" as CR

Admin -> UC: GET /users/analytics
UC -> US: GetAllUsers()
US -> UR: FindAll()
UR --> US: List of users
US -> CR: GetRegistrationStats()
CR --> US: Registration statistics
US --> UC: Analytics data
UC --> Admin: 200 OK + analytics

@enduml
