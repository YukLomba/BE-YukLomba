@startuml User Registration Sequence

actor User
participant "Auth Controller" as AC
participant "Auth Service" as AS
participant "User Repository" as UR
participant "Util" as Util

User -> AC: POST /register (email, password, etc)
AC -> AS: Register(request)
AS -> UR: FindByEmail(email)
UR --> AS: User not found
AS -> UR: FindByUsername(username)
UR --> AS: User not found
AS -> Util: HashPassword(password)
Util --> AS: Hashed password
AS -> UR: Create(user)
UR --> AS: Created user
AS --> AC: User object
AC --> User: 201 Created + user data

@enduml
