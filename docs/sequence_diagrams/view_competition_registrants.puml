@startuml View Competition Registrants

actor Organizer
participant Frontend
participant Backend
participant Database

Organizer -> Frontend: View registrants
Frontend -> Backend: GET /api/competitions/{id}/registrants
Backend -> Database: Verify organizer ownership
alt Not owner
  Backend --> Frontend: 403 Forbidden
  Frontend --> Organizer: Show error
else
  Backend -> Database: Get registrants
  Database --> Backend: Registrants data
  Backend --> Frontend: 200 OK with registrants
  Frontend --> Organizer: Display registrants list
end
@enduml
